{
  "manifest_version": 3,
  "name": "Telegram Media Downloader",
  "version": "0.0.1",
  "description": "Download photos, videos, GIFs and voice from Telegram Web (WebK + WebA), including channels that restrict saving.",
  "author": "SakerLy",
  "homepage_url": "https://github.com/SakerLy/telegram-dl",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["options.html"],
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "telegram-media-downloader@sakerly",
      "strict_min_version": "128.0"
    }
  }
}
